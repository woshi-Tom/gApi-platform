# gAPI Platform - Release Configuration
# Copy this file to .env and modify the passwords before starting

# ===================
# Database
# ===================
POSTGRES_USER=gapi
POSTGRES_PASSWORD=CHANGE_ME_generate_strong_password
POSTGRES_DB=gapi

# ===================
# Redis
# ===================
REDIS_PASSWORD=CHANGE_ME_generate_strong_password

# ===================
# RabbitMQ
# ===================
RABBITMQ_USER=gapi
RABBITMQ_PASSWORD=CHANGE_ME_generate_strong_password

# ===================
# Application Secrets
# ===================
# JWT secret - must be at least 32 characters
JWT_SECRET=CHANGE_ME_use_at_least_32_characters_long_secret_key

# Encryption key - must be at least 32 characters
ENCRYPT_KEY=CHANGE_ME_use_at_least_32_characters_encrypt_key

# ===================
# Application URLs
# ===================
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# ===================
# Payment (Optional)
# ===================
ALIPAY_ENABLED=false
ALIPAY_SANDBOX=true
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
