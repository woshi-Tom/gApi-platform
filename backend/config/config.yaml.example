# gAPI Platform Configuration Template
# Copy this file to config.yaml and fill in your values
# In Docker environment, these values are overridden by environment variables (GAPI_*)

server:
  port: "8080"
  mode: "debug"

database:
  host: "postgres"
  port: 5432
  user: "gapi"
  password: "CHANGE_ME"
  database: "gapi"

redis:
  host: "redis"
  port: 6379

security:
  encrypt_key: "CHANGE_ME_min_32_characters"

jwt:
  secret: "CHANGE_ME_min_32_characters"
  expire_hour: 24

# Cloudflare Turnstile. Docker deployments normally override this with
# TURNSTILE_ENABLED and TURNSTILE_SECRET_KEY from deploy/docker/.env.
# Keep the secret key backend-only; never expose it to frontend code or VITE_* env.
turnstile:
  enabled: true
  secret_key: "1x0000000000000000000000000000000AA"
